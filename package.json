{
  "name": "@watheia/workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "nx format:check && nx affected -t lint stylelint test build e2e",
    "format": "prettier . --write",
    "lint": "nx run-many --target=lint --parallel",
    "stylelint": "nx run-many --target=stylelint --parallel",
    "test": "nx run-many --target=test --parallel --coverage -- --runInBand",
    "build": "nx run-many --target=build --parallel",
    "start": "nx run home:dev --port 4200",
    "e2e": "nx run screenplay:e2e --skip-nx-cache",
    "e2e:setup": "playwright install --with-deps --force"
  },
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.11",
    "front-matter": "^4.0.2",
    "markdown-to-jsx": "^7.7.1",
    "next": "~15.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^15.2.4",
    "@nx/devkit": "21.2.2",
    "@nx/eslint": "21.2.2",
    "@nx/eslint-plugin": "21.2.2",
    "@nx/jest": "21.2.2",
    "@nx/js": "21.2.2",
    "@nx/next": "21.2.2",
    "@nx/playwright": "21.2.2",
    "@nx/workspace": "21.2.2",
    "@playwright/test": "^1.36.0",
    "@stackbit/cms-git": "^1.0.30",
    "@stackbit/types": "^2.1.11",
    "@swc-node/register": "~1.10.10",
    "@swc/cli": "~0.7.8",
    "@swc/core": "~1.12.11",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.13",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "babel-jest": "^29.7.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "^4.1.0",
    "nx": "21.2.2",
    "nx-stylelint": "^18.0.0",
    "postcss": "8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "ts-jest": "^29.1.0",
